# Copy to .env on your machine. Do not commit real passwords.
# Enable Developer settings on the Roku, then use that device password here.

ROKU_DEV_TARGET=192.168.0.50
ROKU_DEV_PASSWORD=replace-me

# Only needed when building a signed package for the Channel Store.
# This is the genkey packaging password from the developer Roku,
# not a TTNS API key. See docs/STORE.md. The channel itself has no secrets.
ROKU_SIGN_PASSWORD=
