<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <interface>
        <field id="action" type="string" alwaysNotify="true" />
        <field id="artworkUrl" type="string" onChange="onArtworkUrl" />
        <field id="titleText" type="string" alias="titleLabel.text" />
        <field id="metaText" type="string" alias="metaLabel.text" />
        <field id="bodyText" type="string" alias="bodyLabel.text" />
        <field id="hintText" type="string" alias="hintLabel.text" />
        <function name="takeFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="DetailScreen.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />
        <Poster
            translation="[80,36]"
            width="72"
            height="72"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/ttns-logo.png" />
        <Label
            translation="[168,48]"
            width="700"
            height="48"
            text="TTNS FM"
            font="font:MediumBoldSystemFont"
            color="0x00FF00FF" />
        <Poster
            id="artwork"
            translation="[80,160]"
            width="560"
            height="560"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/ttns-logo.png" />
        <Label
            id="titleLabel"
            translation="[700,160]"
            width="1140"
            height="120"
            font="font:LargeBoldSystemFont"
            color="0xF6F7F4FF"
            wrap="true" />
        <Label
            id="metaLabel"
            translation="[700,300]"
            width="1140"
            height="70"
            font="font:MediumSystemFont"
            color="0x00FF00FF"
            wrap="true" />
        <Label
            id="bodyLabel"
            translation="[700,390]"
            width="1140"
            height="360"
            font="font:SmallSystemFont"
            color="0xD0D0D0FF"
            wrap="true" />
        <Label
            id="hintLabel"
            translation="[700,780]"
            width="1140"
            height="120"
            font="font:MediumSystemFont"
            color="0xA8A8A8FF"
            wrap="true" />
        <Label
            translation="[80,980]"
            width="1760"
            height="40"
            text="OK for the web address  -  Back to list"
            font="font:SmallestSystemFont"
            color="0x666666FF" />
    </children>
</component>
