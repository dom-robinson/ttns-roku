<?xml version="1.0" encoding="utf-8" ?>
<component name="ListScreen" extends="Group">
    <interface>
        <field id="heading" type="string" alias="headingLabel.text" />
        <field id="statusLine" type="string" alias="statusLabel.text" />
        <field id="kind" type="string" value="gigs" />
        <field id="action" type="string" alwaysNotify="true" />
        <field id="selectedIndex" type="integer" value="-1" />
        <function name="beginLoad" />
        <function name="setItems" />
        <function name="getSelectedItem" />
        <function name="takeFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="ListScreen.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />
        <Poster
            translation="[80,28]"
            width="72"
            height="72"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/ttns-logo.png" />
        <Label
            id="headingLabel"
            translation="[168,36]"
            width="1680"
            height="56"
            font="font:LargeBoldSystemFont"
            color="0x00FF00FF" />
        <Label
            id="statusLabel"
            translation="[80,108]"
            width="1760"
            height="36"
            font="font:SmallSystemFont"
            color="0xA8A8A8FF" />

        <Rectangle id="whenBorder" translation="[80,152]" width="500" height="68" color="0x2A2A2AFF" />
        <Rectangle id="whenFill" translation="[86,158]" width="488" height="56" color="0x161616FF" />
        <Label id="whenLabel" translation="[80,152]" width="500" height="68" text="When  -  All upcoming" font="font:SmallBoldSystemFont" color="0xF6F7F4FF" horizAlign="center" vertAlign="center" />

        <Rectangle id="facetBorder" translation="[600,152]" width="700" height="68" color="0x2A2A2AFF" />
        <Rectangle id="facetFill" translation="[606,158]" width="688" height="56" color="0x161616FF" />
        <Label id="facetLabel" translation="[600,152]" width="700" height="68" text="Venue  -  All venues" font="font:SmallBoldSystemFont" color="0xF6F7F4FF" horizAlign="center" vertAlign="center" />

        <Rectangle id="plansBorder" translation="[1320,152]" width="520" height="68" color="0x2A2A2AFF" />
        <Rectangle id="plansFill" translation="[1326,158]" width="508" height="56" color="0x161616FF" />
        <Label id="plansLabel" translation="[1320,152]" width="520" height="68" text="Promote / prices" font="font:SmallBoldSystemFont" color="0xF6F7F4FF" horizAlign="center" vertAlign="center" />

        <MarkupGrid
            id="grid"
            translation="[80,236]"
            itemComponentName="PosterCard"
            itemSize="[320,380]"
            itemSpacing="[16,16]"
            numColumns="5"
            numRows="2"
            drawFocusFeedback="false" />

        <Group id="loadingPane" visible="false">
            <BusySpinner
                id="spinner"
                translation="[896, 430]"
                uri="pkg:/images/spinner.png"
                clockwise="true"
                spinInterval="0.9" />
            <Label
                id="loadingLabel"
                translation="[360, 580]"
                width="1200"
                height="56"
                text="Loading listings..."
                font="font:MediumBoldSystemFont"
                color="0x00FF00FF"
                horizAlign="center" />
        </Group>
        <Animation id="loadPulse" duration="1.2" easeFunction="linear" repeat="true" optional="true">
            <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[1.0, 0.4, 1.0]" fieldToInterp="loadingLabel.opacity" />
        </Animation>

        <Group id="picker" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000CC" />
            <Rectangle translation="[480,160]" width="960" height="760" color="0x111111FF" />
            <Rectangle translation="[480,160]" width="960" height="8" color="0x00FF00FF" />
            <Label
                id="pickerTitle"
                translation="[520,188]"
                width="880"
                height="50"
                font="font:MediumBoldSystemFont"
                color="0x00FF00FF" />
            <LabelList
                id="pickerList"
                translation="[520,250]"
                itemSize="[880,64]"
                numRows="10"
                color="0xF6F7F4FF"
                focusedColor="0x00FF00FF" />
        </Group>
    </children>
</component>
