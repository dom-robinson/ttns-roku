<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="action" type="string" alwaysNotify="true" />
        <field id="artworkUrl" type="string" onChange="onArtworkUrl" />
        <field id="trackTitle" type="string" alias="trackLabel.text" />
        <field id="stationLine" type="string" alias="stationLabel.text" />
        <field id="statusLine" type="string" alias="statusLabel.text" />
        <field id="streamLine" type="string" alias="streamLabel.text" />
        <field id="isPlaying" type="boolean" onChange="onPlaying" />
        <function name="takeFocus" />
        <function name="startLiveFeeds" />
        <function name="stopLiveFeeds" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="PlayerScreen.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />
        <Poster
            translation="[80,28]"
            width="72"
            height="72"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/ttns-logo.png" />
        <Label
            translation="[168,36]"
            width="700"
            height="56"
            text="LISTEN LIVE"
            font="font:LargeBoldSystemFont"
            color="0x00FF00FF" />
        <Label
            id="stationLabel"
            translation="[880,44]"
            width="960"
            height="48"
            font="font:MediumSystemFont"
            color="0xA8A8A8FF"
            horizAlign="right" />

        <Rectangle id="liveBorder" translation="[80,118]" width="570" height="760" color="0x2A2A2AFF" />
        <Rectangle translation="[84,122]" width="562" height="752" color="0x111111FF" />
        <Poster
            id="artwork"
            translation="[84,122]"
            width="562"
            height="752"
            loadWidth="562"
            loadHeight="752"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/ttns-logo.png"
            failedBitmapUri="pkg:/images/ttns-logo.png" />
        <Rectangle translation="[84,756]" width="562" height="118" color="0x000000AA" />
        <Poster
            translation="[100,772]"
            width="72"
            height="72"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/ttns-logo.png" />
        <Label
            translation="[184,776]"
            width="438"
            height="36"
            text="TTNS FM LIVE"
            font="font:MediumBoldSystemFont"
            color="0x00FF00FF" />
        <Label
            id="statusLabel"
            translation="[184,816]"
            width="438"
            height="32"
            font="font:SmallSystemFont"
            color="0xF6F7F4FF" />

        <Label
            translation="[690,118]"
            width="1140"
            height="28"
            text="NOW PLAYING"
            font="font:SmallestSystemFont"
            color="0x00FF00FF" />
        <Label
            id="trackLabel"
            translation="[690,152]"
            width="1140"
            height="80"
            font="font:LargeBoldSystemFont"
            color="0xFF3B3BFF"
            wrap="true" />
        <Label
            id="streamLabel"
            translation="[690,236]"
            width="1140"
            height="40"
            font="font:SmallSystemFont"
            color="0xFF9A9AFF"
            wrap="true" />

        <Label
            id="onAir"
            translation="[690,286]"
            width="200"
            height="40"
            text="ON AIR"
            font="font:SmallBoldSystemFont"
            color="0x00FF00FF" />
        <Rectangle id="playBorder" translation="[80,892]" width="570" height="112" color="0x00FF00FF" />
        <Rectangle id="playFill" translation="[83,895]" width="564" height="106" color="0x111111FF" />
        <Label
            id="playLabel"
            translation="[80,892]"
            width="570"
            height="112"
            text="PAUSE"
            font="font:LargeBoldSystemFont"
            color="0x00FF00FF"
            horizAlign="center"
            vertAlign="center" />

        <Label
            id="chatHint"
            translation="[690,328]"
            width="1140"
            height="28"
            text=""
            font="font:SmallestSystemFont"
            color="0x00FF00FF"
            horizAlign="right" />

        <Group id="chatClip" translation="[690,370]" clippingRect="[0,0,1140,628]">
            <Group id="chatList" />
        </Group>
        <Rectangle id="chatEndBar" translation="[690, 998]" width="1140" height="6" color="0x2A2A2AFF" />

        <Label
            id="helpLabel"
            translation="[80,1020]"
            width="1760"
            height="40"
            text="OK play / pause  -  Right chat  -  Rewind / FF station  -  Back"
            font="font:SmallestSystemFont"
            color="0x666666FF" />

        <Group id="photoModal" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000EE" />
            <Poster
                id="photoModalImg"
                translation="[120,40]"
                width="1680"
                height="940"
                loadWidth="1680"
                loadHeight="940"
                loadDisplayMode="scaleToFit" />
            <Label
                translation="[80,1000]"
                width="1760"
                height="40"
                text="Back closes the picture"
                font="font:SmallestSystemFont"
                color="0xA8A8A8FF"
                horizAlign="center" />
        </Group>
        <Timer id="feedTimer" repeat="true" duration="8" />
        <Timer id="chatResume" repeat="false" duration="10" />
        <Timer id="chatSnap" repeat="false" duration="0.2" />
        <Animation id="onAirAnim" duration="1.6" easeFunction="linear" repeat="true" optional="true">
            <ColorFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0x00FF00FF, 0xFF8800FF, 0x00FF00FF]" fieldToInterp="onAir.color" />
        </Animation>
    </children>
</component>
