<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float" onChange="onFocusPercent" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="PosterCard.brs" />
    <children>
        <Rectangle id="border" width="320" height="380" color="0x2A2A2AFF" />
        <Rectangle id="bg" translation="[4,4]" width="312" height="372" color="0x141414FF" />
