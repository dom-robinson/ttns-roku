            labelColor="0xF6F7F4FF" />
        <Label
            id="dateLabel"
            translation="[16,278]"
            width="288"
            height="28"
            font="font:SmallestSystemFont"
            color="0x00CC00FF" />
        <MarqueeLabel
            id="metaMarquee"
            translation="[16,308]"
            clipW="288"
            clipH="56"
            fontSize="22"
            bold="false"
            labelColor="0xA8A8A8FF" />
